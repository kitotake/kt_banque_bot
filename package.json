{
  "name": "kt-banque-bot",
  "version": "1.0.0",
  "description": "KT Banque - Bot Discord bancaire RP professionnel",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "deploy": "ts-node src/deploy-commands.ts",
    "deploy:build": "npm run build && npm run deploy",
    "deploy:run": "npm run deploy && npm run start",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.3.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "ms": "^2.1.3",
    "mysql2": "^3.22.3"
  },
  "devDependencies": {
    "@types/ms": "^0.7.34",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
